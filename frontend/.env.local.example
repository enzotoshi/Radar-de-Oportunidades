# Frontend Environment Variables
# Copie este arquivo para .env.local e configure os valores

# ═══════════════════════════════════════════════════════════════════════
# 🗺️ Mapas - OpenStreetMap + Leaflet (100% GRATUITO!)
# ═══════════════════════════════════════════════════════════════════════
# ⚠️ NÃO USE GOOGLE MAPS - É PAGA E CARA!
# 
# Este projeto usa OpenStreetMap + Leaflet (100% gratuito):
#   - Não precisa de chave de API
#   - Não precisa de cartão de crédito
#   - Uso ilimitado
#   - Já configurado e funcionando!
#
# Geocoding API (endereço ↔ coordenadas) - também gratuito
NEXT_PUBLIC_NOMINATIM_URL=https://nominatim.openstreetmap.org

# ═══════════════════════════════════════════════════════════════════════
# 🔌 Backend API URL
# ═══════════════════════════════════════════════════════════════════════
# Em produção: URL do backend deployado no Render
# Em desenvolvimento local: http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Frontend Environment Variables
# Copie este arquivo para .env.local e configure os valores

# ═══════════════════════════════════════════════════════════════════════
# 🗺️ Google Maps API Key
# ═══════════════════════════════════════════════════════════════════════
# Obtenha em: https://console.cloud.google.com/google/maps-apis
# Habilite: Maps JavaScript API, Geocoding API, Places API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# ═══════════════════════════════════════════════════════════════════════
# 🔌 Backend API URL
# ═══════════════════════════════════════════════════════════════════════
# Em produção: URL do backend deployado no Render
# Em desenvolvimento local: http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

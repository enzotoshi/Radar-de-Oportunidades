# Backend
# Desenvolvimento: http://localhost:3000
# Produção: substitua pela URL do projeto na Vercel, por exemplo:
# FRONTEND_URL=https://radar-de-oportunidades.vercel.app
# Para autorizar mais de uma origem, separe as URLs por vírgula.
FRONTEND_URL=http://localhost:3000
PORT=8000
PYTHON_VERSION=3.11.0
API_TIMEOUT=20

# Fontes públicas sem chave
NOMINATIM_API_URL=https://nominatim.openstreetmap.org
PHOTON_API_URL=https://photon.komoot.io/api/
# Identifique a aplicação e mantenha um contato/URL válido conforme a política do serviço.
NOMINATIM_USER_AGENT=RadarOportunidades/3.0 (+https://github.com/enzotoshi/Radar-de-Oportunidades)
# OVERPASS_API_URL=https://overpass-api.de/api/interpreter
IBGE_API_BASE_URL=https://servicodados.ibge.gov.br/api/v3
WORLDPOP_IMAGE_URL=https://worldpop.arcgis.com/arcgis/rest/services/WorldPop_Total_Population_100m/ImageServer
# O serviço acima contém dados até 2020. Não altere sem confirmar os metadados da fonte.
WORLDPOP_YEAR=2020

# Recurso opcional de voz. Sem credenciais, a API retorna indisponibilidade.
# GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json

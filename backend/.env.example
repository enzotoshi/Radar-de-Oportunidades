# Backend Environment Variables
# Copie este arquivo para .env e configure os valores

# URL do frontend (para CORS)
FRONTEND_URL=https://enzotoshi.github.io

# Porta do servidor (será sobrescrita pelo Render em produção)
PORT=8000

# Python version
PYTHON_VERSION=3.11.0

# ═══════════════════════════════════════════════════════════════════════
# 🤖 OpenAI API - Para explicações inteligentes com GPT
# ═══════════════════════════════════════════════════════════════════════
# Obtenha em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=500
OPENAI_TEMPERATURE=0.7

# ═══════════════════════════════════════════════════════════════════════
# 🗺️ Nominatim API - Geocoding GRATUITO (OpenStreetMap)
# ═══════════════════════════════════════════════════════════════════════
# ⚠️ NÃO USE GOOGLE MAPS - É PAGA E CARA!
# Nominatim é 100% gratuito e não precisa de chave de API!
# Documentação: https://nominatim.org/
NOMINATIM_API_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=RadarOportunidades/1.0

# Consulta de estabelecimentos e infraestrutura do OpenStreetMap (sem chave)
# OVERPASS_API_URL=https://overpass-api.de/api/interpreter
# WORLDPOP_IMAGE_URL=https://worldpop.arcgis.com/arcgis/rest/services/WorldPop_Total_Population_100m/ImageServer
# WORLDPOP_YEAR=2020

# ═══════════════════════════════════════════════════════════════════════
# 🎙️ Google Cloud Speech-to-Text API
# ═══════════════════════════════════════════════════════════════════════
# Obtenha em: https://console.cloud.google.com/apis/library/speech.googleapis.com
# Baixe o arquivo JSON de credenciais e coloque na pasta backend/
GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json
GOOGLE_CLOUD_PROJECT_ID=your_project_id

# ═══════════════════════════════════════════════════════════════════════
# 📊 IBGE API - Para dados demográficos reais (não precisa de chave)
# ═══════════════════════════════════════════════════════════════════════
IBGE_API_BASE_URL=https://servicodados.ibge.gov.br/api/v3
USE_IBGE_DATA=true

# ═══════════════════════════════════════════════════════════════════════
# ⚙️ Configurações Gerais
# ═══════════════════════════════════════════════════════════════════════
# Modo de fallback: se true, usa dados simulados quando APIs falharem
ENABLE_FALLBACK=true
API_TIMEOUT=10
